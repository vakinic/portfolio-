---
import { projects } from '../data/projects';
const nameOf = (slug: string) => projects.find((p) => p.slug === slug)?.name ?? slug;
type Ref = { n: string; slug: string } | { label: string; href: string };
interface Line { name: string; tag?: string; text: string; items: string[]; tools: string[]; note?: string; refs: Ref[] }

const lines: Line[] = [
  {
    name: 'Gestión y optimización de marketplaces',
    tag: 'Especialidad',
    text: 'Me ocupo del canal de Mercado Libre completo o de las partes que necesites mejorar, con foco en vender más con mejor margen.',
    items: [
      'Publicaciones y catálogo',
      'Precios y promociones',
      'Campañas de Mercado Ads',
      'Análisis de ventas y rentabilidad',
      'Reputación y gestión operativa',
    ],
    tools: ['Mercado Libre', 'Mercado Ads'],
    note: 'Experiencia también en Amazon Seller Central y FBA.',
    refs: [{ label: 'Ver experiencia', href: '#trayectoria' }],
  },
  {
    name: 'Desarrollo de tiendas online',
    text: 'Tiendas nuevas o rediseños de tiendas existentes, respetando lo nativo de la plataforma: variantes, promociones, cuotas y envíos.',
    items: [
      'Implementación de la tienda',
      'Rediseño de tiendas existentes',
      'Experiencia de compra en mobile',
      'Integraciones y funciones comerciales',
    ],
    tools: ['Shopify', 'Tiendanube'],
    refs: [{ n: '01', slug: 'sawdust' }, { n: '02', slug: 'gold-vision' }],
  },
  {
    name: 'Desarrollo web y soluciones digitales',
    text: 'Sitios, landings y herramientas a medida para cuando el negocio necesita algo más que una tienda.',
    items: [
      'Landing pages y sitios institucionales',
      'Sitios administrables con CMS',
      'Automatizaciones e integraciones',
      'Soluciones a medida',
    ],
    tools: ['Next.js', 'Astro', 'Sanity', 'n8n'],
    refs: [{ n: '03', slug: 'medicos-digitales' }, { n: '04', slug: 'agente-de-agenda' }],
  },
];
---
<section class="svc" id="servicios" aria-labelledby="svc-title">
  <div class="wrap">
    <div class="svc__head">
      <h2 class="h2" id="svc-title">Qué puedo hacer por tus canales de venta</h2>
      <p class="svc__intro">
        Consultoría y gestión de e-commerce como especialidad; desarrollo de tiendas, sitios y soluciones digitales
        cuando el negocio lo necesita.
      </p>
    </div>
    <ul class="svc__list">
      {lines.map((l, i) => (
        <li class:list={['svc__row', { 'svc__row--lead': i === 0 }]}>
          <div class="svc__title">
            {l.tag && <p class="svc__tag">{l.tag}</p>}
            <h3 class="svc__name">{l.name}</h3>
          </div>
          <div class="svc__body">
            <p class="svc__text">{l.text}</p>
            <ul class="svc__items">{l.items.map((it) => <li>{it}</li>)}</ul>
          </div>
          <div class="svc__meta">
            <p class="svc__tools">{l.tools.join(' · ')}</p>
            {l.note && <p class="svc__note">{l.note}</p>}
            {l.refs.length > 0 && (
              <ul class="svc__refs" aria-label="Ejemplos">
                {l.refs.map((r) => (
                  'href' in r ? (
                    <li><a href={r.href}>{r.label}</a></li>
                  ) : (
                    <li><a href={`#${r.slug}`}><span class="svc__tab" aria-hidden="true">{r.n}</span>{nameOf(r.slug)}</a></li>
                  )
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc { padding-top: clamp(5rem, 3rem + 6vw, 10rem); }
  .svc__head {
    display: grid;
    gap: 1rem 4rem;
    align-items: end;
    padding-bottom: 2rem;
  }
  .svc__intro { font-size: var(--fs-lead); color: var(--ink-2); max-width: 40ch; line-height: 1.45; }
  .svc__list { border-top: 1px solid var(--ink); }
  .svc__row {
    display: grid;
    gap: 0.75rem 3rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .svc__name {
    font-size: var(--fs-h3);
    font-stretch: 112%;
    font-weight: 720;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .svc__title { display: grid; gap: 0.5rem; align-content: start; }
  .svc__tag {
    justify-self: start;
    padding: 0.3rem 0.55rem;
    background: var(--blue);
    color: var(--on-blue);
    font-size: var(--fs-label);
    font-weight: 700;
    font-stretch: 75%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }
  .svc__row--lead .svc__name { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); }
  .svc__body { display: grid; gap: 0.75rem; align-content: start; }
  .svc__text { color: var(--ink-2); max-width: 60ch; }
  .svc__items { display: grid; gap: 0.3rem; font-size: var(--fs-sm); }
  .svc__items li { position: relative; padding-left: 1rem; }
  .svc__items li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 2px;
    background: var(--blue);
  }
  .svc__note { font-size: var(--fs-sm); color: var(--ink-2); }
  .svc__meta { display: grid; gap: 0.6rem; align-content: start; }
  .svc__tools { color: var(--ink-3); font-size: var(--fs-sm); }
  .svc__refs { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: var(--fs-sm); }
  .svc__refs a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .svc__tab {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    background: var(--blue);
    color: var(--on-blue);
    font-weight: 760;
    font-stretch: 62%;
    font-size: 0.95rem;
    line-height: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .svc__refs a:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  }

  @media (min-width: 64rem) {
    .svc__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .svc__row { grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); align-items: start; padding-block: 2rem; }
    .svc__refs a { min-height: 2rem; }
  }
</style>
