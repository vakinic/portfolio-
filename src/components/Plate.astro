---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  eager?: boolean;
  /** Mount colour: catalog grey on paper, or a darker mount on the ink band. */
  tone?: 'paper' | 'ink';
  sizes?: string;
  /** Phone-only helper shown in the caption slot before any number is tapped. */
  hint?: string;
}
const { project, eager = false, tone = 'paper', sizes = '(min-width: 90rem) 82rem, 100vw', hint } = Astro.props;
const { plate } = project;
const pct = (n: number) => `${n}%`;
---
<figure class:list={['plate', `plate--${tone}`]}>
  <div class="plate__frame" data-reveal>
    <Image
      src={plate.src}
      alt={plate.alt}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="plate__img"
    />
    {plate.callouts.map((c, i) => (
      <span
        class="plate__region"
        data-region={i + 1}
        style={{ left: pct(c.region.x), top: pct(c.region.y), width: pct(c.region.w), height: pct(c.region.h) }}
        aria-hidden="true"
      />
    ))}
    {plate.callouts.map((c, i) => (
      <button
        type="button"
        class="plate__marker"
        data-target={i + 1}
        style={{ left: pct(c.pin?.x ?? c.region.x), top: pct(c.pin?.y ?? c.region.y) }}
        aria-label={`${i + 1}: ${c.title}`}
        aria-pressed="false"
      >{i + 1}</button>
    ))}
  </div>
  <p class:list={['plate__caption', { 'has-hint': hint }]} data-hint={hint} aria-live="polite">{hint}</p>
</figure>

<style>
  .plate {
    margin: 0;
    padding: clamp(0.5rem, 0.2rem + 1.4vw, 1.75rem);
    background: var(--paper-2);
  }
  .plate--ink { background: var(--mount-on-ink); }
  .plate__frame {
    position: relative;
    overflow: hidden;
    background: var(--paper-2);
    outline: 1px solid var(--ink);
  }
  .plate--ink .plate__frame { outline-color: var(--line-on-ink); }
  .plate__frame :global(.plate__img) { display: block; width: 100%; height: auto; }

  .plate__region {
    position: absolute;
    outline: 2px solid var(--blue);
    outline-offset: -1px;
    box-shadow: 0 0 0 200vmax rgb(17 17 17 / 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-out);
  }
  .plate--ink .plate__region { outline-color: var(--blue-light); }
  .plate__region.is-on { opacity: 1; }

  .plate__marker {
    position: absolute;
    z-index: 2;
    transform: translate(0.5rem, 0.5rem);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: var(--on-blue);
    border: 0;
    font: inherit;
    font-weight: 760;
    font-stretch: 62%;
    font-size: 1.125rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, transform 140ms var(--ease-out);
  }
  .plate__marker::after {
    /* larger touch target than the visible square */
    content: '';
    position: absolute;
    inset: -0.375rem;
  }
  .plate__marker[aria-pressed='true'] { background: var(--paper); color: var(--blue); }
  .plate__marker:active { transform: translate(0.5rem, 0.5rem) scale(0.94); }

  /* Phones: what the tapped number points at, read below the image so nothing covers the zone */
  .plate__caption {
    display: none;
    margin: 0.75rem 0 0;
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .plate--ink .plate__caption { color: var(--on-ink-2); }
  .plate__caption :global(b) { display: block; font-weight: 660; color: var(--ink); }
  .plate--ink .plate__caption :global(b) { color: var(--on-ink); }
  .plate__caption.is-on, .plate__caption.has-hint { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .plate__caption.is-on { animation: cap-in 220ms var(--ease-out); }
  }
  @keyframes cap-in { from { opacity: 0; transform: translateY(-4px); } }

  @media (min-width: 64rem) {
    /* Desktop reads the callout list beside the plate; showing the caption here would reflow the plate under the cursor */
    .plate__caption,
    .plate__caption.is-on,
    .plate__caption.has-hint { display: none; }
  }
  @media (max-width: 30rem) {
    /* Smaller marks on phones so they sit beside the content, not on it; ::after keeps a 44px target */
    .plate__marker { width: 1.375rem; height: 1.375rem; font-size: 0.875rem; transform: translate(0.2rem, 0.2rem); }
    .plate__marker::after { inset: -0.75rem; }
    .plate__marker:active { transform: translate(0.2rem, 0.2rem) scale(0.94); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate__region { transition: opacity 120ms linear; }
  }
</style>
