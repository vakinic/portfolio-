---
import type { Project } from '../data/projects';
interface Props { project: Project; as?: 'h1' | 'h2' }
const { project: p, as: Tag = 'h2' } = Astro.props;
---
<header class="sh">
  <span class="sh__tab" aria-hidden="true">{p.ref}</span>
  <div class="sh__titles">
    <Tag class="sh__name" id={`${p.slug}-title`}>{p.name}</Tag>
    <p class="sh__meta">
      <span>{p.kind} · {p.platform} · {p.year}</span>
      <span class:list={['status', `status--${p.status}`]}>{p.statusLabel}</span>
    </p>
  </div>
</header>

<style>
  .sh {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem 1.25rem;
    align-items: start;
  }
  .sh__tab {
    display: grid;
    place-items: center;
    width: clamp(3.25rem, 2.4rem + 3vw, 5.5rem);
    aspect-ratio: 1;
    margin-top: 0.15em;
    background: var(--blue);
    color: var(--on-blue);
    font-weight: 780;
    font-stretch: 62%;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    line-height: 1;
  }
  .sh__titles { display: grid; gap: 0.7rem; min-width: 0; }
  .sh__name {
    font-size: clamp(2.375rem, 0.9rem + 6vw, 5.5rem);
    font-stretch: var(--display-stretch, 125%);
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 0.88;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .sh__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .sh__meta .status { font-weight: 560; }
</style>
