---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import reputacion from '../assets/trayectoria/reputacion.png';

/**
 * Evolución de facturación mensual del canal ($8M → pico de $130M, pesos).
 * Oculta hasta confirmar fechas de inicio y del pico y si son valores nominales:
 * sin ese contexto la comparación se lee como crecimiento real. Para mostrarla,
 * completar `period` y pasar `show` a true.
 */
const revenue = { show: false, from: '$8M', to: '$130M', period: '' };

/** Verificados con capturas reales: perfil de vendedor (+10mil ventas, Platinum)
 *  y panel de Mercado Ads del 15/11 al 14/12/2025 (ingresos / inversión = 13,8). */
const facts = [
  { value: 'MercadoLíder Platinum', label: 'Reputación de la cuenta' },
  { value: 'ROAS de 13×', label: 'Alcanzado en Product Ads (15 nov – 14 dic 2025)' },
];
---
<section class="trk" id="trayectoria" aria-labelledby="trk-title">
  <div class="wrap">
    <h2 class="trk__title" id="trk-title">Más de cinco años gestionando e-commerce desde adentro.</h2>
    <p class="trk__figure" aria-describedby="trk-figcap">+10.000<span class="trk__unit">ventas</span></p>
    <p class="trk__figcap" id="trk-figcap">En la cuenta de Mercado Libre de la importadora que gestioné.</p>
    {revenue.show && revenue.period && (
      <p class="trk__revenue">
        Facturación mensual del canal: de {revenue.from} a un pico de {revenue.to} ({revenue.period}).
      </p>
    )}

    <ul class="trk__facts">
      {facts.map((f) => (
        <li><strong>{f.value}</strong><span>{f.label}</span></li>
      ))}
    </ul>

    <div class="trk__grid">
      <div class="trk__text">
        <p>
          Durante más de cinco años gestioné el canal de Mercado Libre de una empresa importadora de herramientas:
          catálogo, precios, promociones, publicidad, métricas y coordinación del equipo operativo.
        </p>
        <p>
          Esa operación diaria es la base de lo que hago hoy: decisiones sobre publicaciones, precios y campañas, y
          tiendas pensadas para lo que pasa después de la venta: stock, cuotas, preguntas del cliente y margen.
        </p>
        <p class="trk__also">
          También: Amazon Seller Central, envíos FBA y sourcing desde China.
        </p>
        <a class="trk__cta link" href="#contacto" data-pick="mercadolibre">
          Consultar por gestión de Mercado Libre<Icon name="arrow-right" />
        </a>
      </div>
      <figure class="trk__fig">
        <div class="trk__mount" data-reveal>
          <Image
            src={reputacion}
            alt="Panel de reputación de Mercado Libre: MercadoLíder Platinum, 2.851 ventas en 60 días, reclamos 0,45 %, mediaciones 0 %, cancelaciones 0,38 %."
            widths={[480, 720, 1080]}
            sizes="(min-width: 64rem) 46vw, 100vw"
            loading="lazy"
          />
        </div>
        <figcaption>Reputación del canal en 60 días: reclamos 0,45 % y mediaciones 0 %.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .trk {
    margin-top: clamp(5rem, 3rem + 6vw, 10rem);
    padding-block: clamp(4rem, 2.5rem + 5vw, 8rem);
    background: var(--ink);
    color: var(--on-ink);
  }
  .trk ::selection { background: var(--paper); color: var(--ink); }
  .trk :focus-visible { outline-color: var(--blue-light); }
  .trk__title {
    font-size: var(--fs-h2);
    font-stretch: 112%;
    font-weight: 720;
    letter-spacing: -0.03em;
    line-height: 1.02;
    max-width: 22ch;
    text-wrap: balance;
  }
  .trk__figure {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.12em;
    font-size: var(--fs-figure);
    font-stretch: var(--display-stretch, 125%);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 0.86;
    color: var(--paper);
  }
  .trk__unit {
    margin-left: 0.3em;
    font-size: 0.32em;
    font-stretch: 100%;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--on-ink-2);
    align-self: flex-end;
    padding-bottom: 0.12em;
  }
  .trk__revenue { margin-top: 0.5rem; color: var(--on-ink-2); font-size: var(--fs-sm); max-width: 52ch; }
  .trk__facts {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line-on-ink);
  }
  .trk__facts li {
    display: grid;
    gap: 0.2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line-on-ink);
  }
  .trk__facts strong {
    font-size: var(--fs-h3);
    font-weight: 720;
    font-stretch: 112%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--paper);
  }
  .trk__facts span { font-size: var(--fs-sm); color: var(--on-ink-2); }
  .trk__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    justify-self: start;
    font-weight: 600;
    color: var(--on-ink);
  }
  .trk__cta :global(svg) { width: 1.1em; height: 1.1em; }
  .trk__figcap {
    margin-top: 1rem;
    font-size: var(--fs-lead);
    color: var(--on-ink-2);
    max-width: 40ch;
  }
  .trk__grid {
    margin-top: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
    display: grid;
    gap: 2.5rem 4rem;
  }
  .trk__text { display: grid; gap: 1.1rem; align-content: start; }
  .trk__text p { max-width: 52ch; color: var(--on-ink-2); }
  .trk__text p:first-child { color: var(--on-ink); font-size: 1.125rem; }
  .trk__also { font-size: var(--fs-sm); }
  .trk__fig { margin: 0; display: grid; gap: 0.6rem; }
  .trk__mount { background: var(--mount-on-ink); padding: clamp(0.5rem, 0.2rem + 1.2vw, 1.25rem); }
  .trk__mount :global(img) { display: block; width: 100%; height: auto; }
  .trk__fig figcaption { font-size: var(--fs-sm); color: var(--on-ink-2); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .trk__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
    .trk__facts li { border-bottom: 0; padding-block: 1.25rem 0; }
  }
  @media (min-width: 64rem) {
    .trk__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }
</style>
