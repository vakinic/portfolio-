---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { projects } from '../data/projects';
import { waLink } from '../data/site';
---
<section class="cover" aria-labelledby="cover-title">
  <div class="wrap cover__grid">
    <div class="cover__head">
      <h1 id="cover-title" class="cover__title">
        Tiendas, sitios y automatizaciones pensados para vender.
      </h1>
    </div>
    <div class="cover__main">
      <p class="cover__lede">
        Soy Nicolás Ferreira. Diseño y desarrollo tiendas en Tiendanube y Shopify, sitios con CMS y
        automatizaciones con IA. Antes de construir tiendas, las operé: más de 5 años al frente del canal
        de Mercado Libre de una importadora.
      </p>
      <div class="cover__actions">
        <a class="btn btn--blue" href={waLink('Hola Nicolás, vi tu portfolio y quiero consultarte por un proyecto.')} target="_blank" rel="noopener noreferrer">
          <Icon name="chat" />Escribime por WhatsApp
        </a>
        <a class="btn btn--line" href="#trabajos">Ver trabajos<Icon name="arrow-down" /></a>
      </div>
    </div>

    <nav class="index" aria-label="Trabajos">
      <ol>
        {projects.map((p, i) => (
          <li>
            <a class="index__row" href={`#${p.slug}`}>
              <span class="index__tab" aria-hidden="true">{p.ref}</span>
              <span class="index__thumb" aria-hidden="true">
                <Image src={p.plate.src} alt="" widths={[160, 240, 320]} sizes="(min-width: 48rem) 7.5rem, 5rem" loading={i < 2 ? 'eager' : 'lazy'} class="index__img" />
              </span>
              <span class="index__body">
                <span class="index__name">{p.name}</span>
                <span class="index__kind">{p.kind} · {p.platform}</span>
              </span>
              <span class:list={['index__status status', `status--${p.status}`]}>{p.statusLabel}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .cover { padding-top: clamp(2rem, 0.8rem + 3vw, 3.5rem); }
  .cover__title {
    font-size: var(--fs-display);
    font-stretch: var(--display-stretch, 125%);
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-wrap: balance;
    max-width: 22ch;
    overflow-wrap: break-word;
  }
  /* Una sola grilla: título y bajada a la izquierda, índice a la derecha ocupando ambas filas. */
  .cover__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "head" "main" "index";
  }
  .cover__head { grid-area: head; min-width: 0; container-type: inline-size; }
  .cover__main { grid-area: main; min-width: 0; margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem); }
  .cover__lede {
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .cover__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .index {
    grid-area: index;
    min-width: 0;
    margin-top: 2.5rem;
    border-top: 1px solid var(--ink);
    container-type: inline-size;
  }
  .index li { border-bottom: 1px solid var(--line); }
  .index__row {
    display: grid;
    grid-template-columns: 2.75rem 5rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    align-items: center;
    padding-block: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }
  .index__tab {
    align-self: stretch;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: var(--on-blue);
    font-weight: 760;
    font-stretch: 62%;
    font-size: 1.25rem;
    line-height: 1;
    transition: background-color 160ms ease;
  }
  .index__thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper-2);
    outline: 1px solid var(--line);
  }
  .index__thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 400ms var(--ease-out);
  }
  .index__body { display: grid; gap: 0.1rem; min-width: 0; }
  .index__name {
    font-size: 1.25rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .index__kind { font-size: var(--fs-sm); color: var(--ink-2); }
  .index__status { grid-column: 3; font-size: var(--fs-sm); font-weight: 560; }
  @media (hover: hover) and (pointer: fine) {
    .index__row:hover .index__tab { background: var(--ink); }
    .index__row:hover .index__thumb :global(img) { transform: scale(1.06); }
    .index__row:hover .index__name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  }

  @media (min-width: 48rem) {
    .index__row { grid-template-columns: 3rem 7.5rem minmax(0, 1fr); }
  }
  @media (min-width: 64rem) {
    .cover__grid {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "head  index"
        "main  index";
      column-gap: clamp(2.5rem, 4vw, 4rem);
      align-items: start;
    }
    /* El título llena su columna: "automatizaciones", la palabra más larga, mide 10.3em. */
    .cover__title { font-size: min(var(--fs-display), 9.6cqi); max-width: none; }
    .cover__main { margin-top: clamp(1.75rem, 0.5rem + 2vw, 3rem); }
    .index {
      margin-top: 0;
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }
    /* Las filas se reparten la altura de las dos filas de la izquierda. */
    .index ol { flex: 1; display: grid; grid-auto-rows: 1fr; }
    .index li { display: grid; }
    .index__row { align-content: center; }
  }

  /* El estado pasa a su propia columna, a la derecha, cuando el índice tiene ancho para eso.
     Entre 31 y 36rem (desktop angosto) se compactan número, miniatura y separaciones. */
  @container (min-width: 31rem) {
    .index__row { grid-template-columns: 2.75rem 6rem minmax(0, 1fr) auto; column-gap: 0.75rem; }
    .index__status { grid-column: auto; justify-self: end; white-space: nowrap; }
    .index__kind { text-wrap: balance; }
  }
  @container (min-width: 36rem) {
    .index__row { grid-template-columns: 3rem 7.5rem minmax(0, 1fr) auto; column-gap: 1rem; }
  }
</style>
