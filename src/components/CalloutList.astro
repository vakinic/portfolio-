---
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project } = Astro.props;
---
<ol class="co" aria-label={`Qué se construyó en ${project.name}`}>
  {project.plate.callouts.map((c, i) => (
    <li>
      <button type="button" class="co__item" data-target={i + 1} aria-pressed="false">
        <span class="co__n" aria-hidden="true">{i + 1}</span>
        <span class="co__text">
          <span class="co__title">{c.title}</span>
          <span class="co__detail">{c.detail}</span>
          {c.impl && <span class="co__impl label">{c.impl}</span>}
        </span>
      </button>
    </li>
  ))}
</ol>

<style>
  .co { border-top: 1px solid var(--ink); }
  .co li { border-bottom: 1px solid var(--line); }
  .co__item {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.9rem;
    width: 100%;
    padding: 1rem 0;
    text-align: left;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .co__n {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--blue);
    color: var(--blue);
    font-weight: 760;
    font-stretch: 62%;
    font-size: 1.125rem;
    line-height: 1;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .co__text { display: grid; gap: 0.3rem; }
  .co__title { font-weight: 660; font-size: 1.0625rem; line-height: 1.3; }
  .co__detail { color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.5; }
  .co__impl { color: var(--blue); margin-top: 0.2rem; }
  .co__item[aria-pressed='true'] .co__n { background: var(--blue); color: var(--on-blue); }
  @media (hover: hover) and (pointer: fine) {
    .co__item:hover .co__n { background: var(--blue); color: var(--on-blue); }
  }
</style>
