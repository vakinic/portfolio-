---
// The order is the method itself, so steps keep their sequence number.
const steps = [
  { t: 'Diagnóstico del negocio', d: 'Reviso cómo vendés hoy: canales, catálogo, publicaciones, tienda y números disponibles.', out: 'Prioridades por escrito.' },
  { t: 'Objetivos y estrategia', d: 'Definimos qué queremos mejorar, en qué orden y cómo lo vamos a medir.', out: 'Plan con alcance y plazos.' },
  { t: 'Implementación', d: 'Publicaciones, campañas, tienda o desarrollo. Trabajo en borradores, tiendas de prueba o versiones aparte, sin frenar tu operación.', out: 'Cambios probados antes de publicarse.' },
  { t: 'Seguimiento y optimización', d: 'Revisamos resultados y ajustamos. Puede ser una revisión al cierre del proyecto o una gestión mensual, según el alcance.', out: 'Próximos pasos definidos con datos.' },
];
---
<section class="mth" aria-labelledby="mth-title">
  <div class="wrap mth__grid">
    <div class="mth__head">
      <h2 class="h2" id="mth-title">Cómo trabajo</h2>
      <p class="mth__intro">El mismo método para gestionar un canal o desarrollar una tienda; cambia el alcance que definimos juntos.</p>
    </div>
    <ol class="mth__list">
      {steps.map((s, i) => (
        <li class="mth__step">
          <span class="mth__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="mth__body">
            <h3 class="mth__t">{s.t}</h3>
            <p class="mth__d">{s.d}</p>
            <p class="mth__out">{s.out}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .mth { padding-top: clamp(5rem, 3rem + 6vw, 10rem); }
  .mth__grid { display: grid; gap: 2rem 4rem; }
  .mth__head { display: grid; gap: 1rem; align-content: start; }
  .mth__intro { color: var(--ink-2); max-width: 34ch; }
  .mth__list { display: grid; gap: 0 3rem; }
  .mth__step {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0 1rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .mth__n {
    font-weight: 780;
    font-stretch: 62%;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--ink);
  }
  .mth__body { display: grid; gap: 0.3rem; }
  .mth__t { font-weight: 700; font-stretch: 105%; font-size: var(--fs-h3); line-height: 1.15; letter-spacing: -0.01em; }
  .mth__d { color: var(--ink-2); font-size: var(--fs-sm); max-width: 48ch; }
  .mth__out { font-size: var(--fs-sm); font-weight: 560; }

  @media (min-width: 64rem) {
    .mth__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: start; }
    .mth__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mth__step { padding-block: 1.5rem; }
    /* Los pasos de una misma fila comparten las alturas de título, descripción y resultado,
       así un título en dos líneas no desalinea al paso vecino. */
    .mth__list { grid-auto-rows: auto auto auto; }
    .mth__step { grid-row: span 3; grid-template-rows: subgrid; row-gap: 0.3rem; }
    .mth__n { grid-row: 1; }
    .mth__body { grid-row: 1 / span 3; grid-template-rows: subgrid; gap: 0.3rem; }
  }
</style>
