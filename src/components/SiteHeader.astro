---
import Icon from './Icon.astro';
import { nav, site, waLink } from '../data/site';
---
<header class="hdr">
  <div class="wrap hdr__bar">
    <a class="hdr__name" href="/" aria-label={`${site.name}, inicio`}>
      Nicolás Ferreira
    </a>
    <nav class="hdr__nav" aria-label="Principal">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="hdr__actions">
      <a class="btn btn--blue hdr__cta" href={waLink('Hola Nicolás, vi tu portfolio y quiero consultarte por un proyecto.')} target="_blank" rel="noopener noreferrer">
        <Icon name="chat" />WhatsApp
      </a>
      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
  <nav class="hdr__sheet" id="menu-movil" aria-label="Menú" hidden>
    <ul class="wrap">
      {nav.map((item) => <li><a href={item.href}>{item.label}<Icon name="arrow-right" /></a></li>)}
    </ul>
  </nav>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top);
  }
  .hdr__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .hdr__name {
    font-weight: 760;
    font-stretch: 80%;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }
  .hdr__nav ul { display: flex; gap: 1.75rem; }
  .hdr__nav a {
    font-size: var(--fs-sm);
    font-weight: 520;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.5rem;
    background: linear-gradient(var(--ink), var(--ink)) left bottom / 0 1px no-repeat;
    transition: color 160ms ease, background-size 220ms var(--ease-out);
  }
  .hdr__nav a[aria-current='true'] { color: var(--ink); background-size: 100% 1px; }
  @media (hover: hover) and (pointer: fine) {
    .hdr__nav a:hover { color: var(--ink); background-size: 100% 1px; }
  }
  .hdr__actions { display: flex; align-items: center; gap: 0.5rem; }
  .hdr__cta { min-height: 2.5rem; padding: 0 1rem; }
  .hdr__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .hdr__toggle svg { width: 1.375rem; height: 1.375rem; }
  .hdr__toggle .i-close { display: none; }
  .hdr__toggle[aria-expanded='true'] .i-open { display: none; }
  .hdr__toggle[aria-expanded='true'] .i-close { display: block; }

  .hdr__sheet {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }
  .hdr__sheet li + li { border-top: 1px solid var(--line); }
  .hdr__sheet a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .hdr__sheet svg { width: 1.25rem; height: 1.25rem; color: var(--blue); }

  @media (max-width: 47.99rem) {
    .hdr__nav { display: none; }
    .hdr__toggle { display: inline-flex; }
    .hdr__cta { padding: 0 0.85rem; }
  }
  @media (min-width: 48rem) {
    .hdr__sheet { display: none !important; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.hdr__toggle');
  const sheet = document.getElementById('menu-movil');

  function setOpen(open: boolean) {
    if (!toggle || !sheet) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    sheet.hidden = !open;
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Mark the section currently in view (home only; other pages have no matching ids).
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.hdr__nav a'));
  const sections = links
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((el): el is HTMLElement => Boolean(el));
  if (sections.length && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const mark = () => {
      // The last section (in page order) that crosses the middle band wins; none means the cover.
      const current = sections.filter((s) => visible.has(s.id)).pop()?.id;
      links.forEach((a) => {
        if (current && a.hash === `#${current}`) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        mark();
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
