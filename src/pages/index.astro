                      />
                    ))}
                  </div>
                  <button
                    type="button"
                    class="absolute left-1.5 top-1/2 -translate-y-1/2 z-10 w-7 h-7 flex items-center justify-center rounded-full bg-black/30 hover:bg-black/50 text-white transition-colors"
                    data-carousel-prev
                    aria-label="Imagen anterior"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="absolute right-1.5 top-1/2 -translate-y-1/2 z-10 w-7 h-7 flex items-center justify-center rounded-full bg-black/30 hover:bg-black/50 text-white transition-colors"
                    data-carousel-next
                    aria-label="Imagen siguiente"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5 15.75 12l-7.5 7.5" />
                    </svg>
                  </button>
                  <div class="absolute bottom-2 inset-x-0 z-10 flex justify-center gap-1.5" data-carousel-dots>
                    {proyecto.imagenes.map((_, di) => (
                      <span
                        class={`w-1.5 h-1.5 rounded-full transition-colors ${di === 0 ? "bg-white" : "bg-white/50"}`}
                        data-dot
                      ></span>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="h-44 overflow-hidden bg-zinc-200 dark:bg-zinc-800">
                  {proyecto.imagen ? (
                    <img
                      src={proyecto.imagen}
                      alt={proyecto.titulo}
                      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500 cursor-zoom-in select-none"
                      onclick="openLightbox(this.src, this.alt)"
                      draggable="false"
                    />
                  ) : (
                    <div
                      class="w-full h-full flex items-end p-4"
                      style={proyecto.bgStyle}
                    >
                      <span class="text-sm font-medium text-zinc-400">{proyecto.titulo}</span>
                    </div>
                  )}
                </div>
              )}
              <div class="p-4 sm:p-5">
                <h3 class="font-semibold text-zinc-900 dark:text-white mb-1.5">{proyecto.titulo}</h3>
                <p class="text-sm text-zinc-500 leading-relaxed mb-4">{proyecto.descripcion}</p>
                <div class="flex flex-wrap gap-1.5">
                  {proyecto.tags.map((tag) => (
                    <span class="text-xs text-zinc-500 dark:text-zinc-500 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-2 py-0.5 rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
