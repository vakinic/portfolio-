---
// One stroke icon set (24px grid, 1.6 stroke) so every glyph shares weight.
type Name = 'arrow-right' | 'arrow-down' | 'arrow-up-right' | 'menu' | 'close' | 'chat' | 'mail' | 'linkedin';
interface Props { name: Name; class?: string; [key: string]: unknown }
const { name, class: cls, ...rest } = Astro.props;

const paths: Record<Name, string> = {
  'arrow-right': 'M4 12h15M13 6l6 6-6 6',
  'arrow-down': 'M12 4v15M6 13l6 6 6-6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  menu: 'M3.5 7h17M3.5 12h17M3.5 17h17',
  close: 'M5.5 5.5l13 13M18.5 5.5l-13 13',
  chat: 'M4 19.5l1.3-3.9A8 8 0 1 1 8.4 18.7L4 19.5Z',
  mail: 'M3.5 6.5h17v11h-17zM3.5 7l8.5 6.5L20.5 7',
  linkedin: 'M4.5 9.5v10M4.5 5v.01M9 19.5v-10M9 13.5c0-2.2 1.6-4 3.8-4s3.7 1.6 3.7 4v6',
};
---
<svg {...rest} class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>
