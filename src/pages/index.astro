            >
              LinkedIn
            </a>
            <a
              href="mailto:fernicnet@gmail.com"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 sm:py-2.5 rounded-lg text-sm font-semibold text-white transition-all duration-200 active:opacity-80"
