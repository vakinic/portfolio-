---
import { Image } from 'astro:assets';
import type { Figure } from '../data/projects';

interface Props { figures: Figure[]; refNum: string; label: string }
const { figures, refNum, label } = Astro.props;
---
{figures.length > 0 && (
  <div class="strip" role="region" aria-label={label} tabindex="0">
    {figures.map((f, i) => {
      const ratio = f.src.width / f.src.height;
      return (
        <figure class="strip__fig" style={{ '--r': ratio.toFixed(4) }}>
          <div class="strip__frame">
            <Image
              src={f.src}
              alt={f.alt}
              widths={f.kind !== 'desktop' ? [280, 420, 560] : [640, 960, 1280]}
              sizes={f.kind !== 'desktop' ? '(min-width: 64rem) 16rem, 60vw' : '(min-width: 64rem) 40vw, 88vw'}
              loading="lazy"
              class="strip__img"
            />
          </div>
          <figcaption class="label strip__cap">
            <span>Fig. {refNum}.{i + 1}</span>
            <span>{f.caption}</span>
          </figcaption>
        </figure>
      );
    })}
  </div>
)}

<style>
  .strip {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .strip:focus-visible { outline-offset: 6px; }
  .strip__fig {
    margin: 0;
    flex: none;
    height: auto;
    width: calc(var(--r) * min(26rem, 62svh));
    max-width: 88vw;
    scroll-snap-align: start;
  }
  .strip__fig { background: var(--paper-2); padding: 0.6rem 0.6rem 0.7rem; }
  .strip__frame { outline: 1px solid var(--ink); background: var(--paper-2); }
  .strip__img { display: block; width: 100%; height: auto; }
  .strip__cap {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.55rem;
    color: var(--ink-3);
  }
  .strip__cap span:last-child { color: var(--ink-2); text-transform: none; letter-spacing: 0; font-stretch: 100%; font-weight: 450; font-size: var(--fs-sm); }

  @media (min-width: 64rem) {
    /* Equal heights: each figure grows in proportion to its aspect ratio. */
    .strip { overflow: visible; scroll-snap-type: none; padding-bottom: 0; gap: 1.25rem; }
    .strip__fig { flex: var(--r) 1 0; width: 0; max-width: none; }
  }
</style>
