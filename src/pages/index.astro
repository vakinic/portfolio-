        </div>
        <div class="flex items-center gap-6">
          <a href="https://wa.me/5491138158237" target="_blank" rel="noopener noreferrer" class="text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors">WhatsApp</a>
          <a href="https://www.linkedin.com/in/nicolas-ferreira-039254232/" target="_blank" rel="noopener noreferrer" class="text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors">LinkedIn</a>
          <a href="mailto:fernicnet@gmail.com" class="text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors">Email</a>
        </div>
      </div>
    </footer>

    <script>
      const html = document.documentElement;

      // ─── Theme ───────────────────────────────────────────────────────────
      const saved = localStorage.getItem('theme');
      if (saved === 'light') html.classList.remove('dark');

      function updateThemeColor() {
        const color = html.classList.contains('dark') ? '#09090b' : '#ffffff';
        document.getElementById('meta-theme-color')?.setAttribute('content', color);
      }
      updateThemeColor();

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        updateThemeColor();
      });

      // ─── Mobile menu ─────────────────────────────────────────────────────
      const menuToggle   = document.getElementById('menu-toggle') as HTMLButtonElement;
      const mobileMenu   = document.getElementById('mobile-menu') as HTMLElement;
      const iconHamburger = document.getElementById('icon-hamburger') as HTMLElement;
      const iconX        = document.getElementById('icon-x') as HTMLElement;

      function openMobileMenu() {
        mobileMenu.classList.add('is-open');
        mobileMenu.setAttribute('aria-hidden', 'false');
        menuToggle.setAttribute('aria-expanded', 'true');
        iconHamburger.classList.add('hidden');
        iconX.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileMenu() {
        mobileMenu.classList.remove('is-open');
        mobileMenu.setAttribute('aria-hidden', 'true');
        menuToggle.setAttribute('aria-expanded', 'false');
        iconHamburger.classList.remove('hidden');
        iconX.classList.add('hidden');
        document.body.style.overflow = '';
      }

      menuToggle?.addEventListener('click', () => {
        mobileMenu.classList.contains('is-open') ? closeMobileMenu() : openMobileMenu();
      });

      // Close on ESC
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          closeMobileMenu();
          closeLightbox();
        }
      });

      // Close mobile menu when user scrolls (likely browsing)
      let lastScrollY = window.scrollY;
      window.addEventListener('scroll', () => {
        if (Math.abs(window.scrollY - lastScrollY) > 40 && mobileMenu.classList.contains('is-open')) {
          closeMobileMenu();
        }
        lastScrollY = window.scrollY;
      }, { passive: true });

      // Make close available globally for onclick attributes on menu links
      (window as any).closeMobileMenu = closeMobileMenu;

      // ─── Lightbox ────────────────────────────────────────────────────────
      const lightboxImgEl  = document.getElementById('lightbox-img') as HTMLImageElement;
      const lightboxPrevEl = document.getElementById('lightbox-prev') as HTMLElement;
      const lightboxNextEl = document.getElementById('lightbox-next') as HTMLElement;
      const lightboxDotsEl = document.getElementById('lightbox-dots') as HTMLElement;
      const lightboxHintEl = document.getElementById('lightbox-hint') as HTMLElement;

      let lightboxGallery: string[] = [];
      let lightboxIndex = 0;
      let lightboxAlt = '';

      function renderLightboxImage() {
        lightboxImgEl.src = lightboxGallery[lightboxIndex];
        lightboxImgEl.alt = lightboxAlt;

        const hasMultiple = lightboxGallery.length > 1;
        lightboxPrevEl.classList.toggle('hidden', !hasMultiple);
        lightboxPrevEl.classList.toggle('flex', hasMultiple);
        lightboxNextEl.classList.toggle('hidden', !hasMultiple);
        lightboxNextEl.classList.toggle('flex', hasMultiple);
        lightboxDotsEl.classList.toggle('hidden', !hasMultiple);
        lightboxDotsEl.classList.toggle('flex', hasMultiple);
        lightboxHintEl.classList.toggle('hidden', hasMultiple);

        if (hasMultiple) {
          lightboxDotsEl.innerHTML = lightboxGallery
            .map((_, i) => `<span class="w-1.5 h-1.5 rounded-full transition-colors ${i === lightboxIndex ? 'bg-white' : 'bg-white/40'}"></span>`)
            .join('');
        }
      }

      function lightboxNav(delta: number) {
        if (lightboxGallery.length < 2) return;
        lightboxIndex = (lightboxIndex + delta + lightboxGallery.length) % lightboxGallery.length;
        renderLightboxImage();
      }

      function openLightbox(src: string, alt: string) {
        lightboxGallery = [src];
        lightboxIndex = 0;
        lightboxAlt = alt;
        renderLightboxImage();
        const lightbox = document.getElementById('lightbox') as HTMLElement;
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function openLightboxGallery(gallery: string[], index: number, alt: string) {
        lightboxGallery = gallery;
        lightboxIndex = index;
        lightboxAlt = alt;
        renderLightboxImage();
        const lightbox = document.getElementById('lightbox') as HTMLElement;
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        const lightbox = document.getElementById('lightbox') as HTMLElement;
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }

      // Arrow keys navigate the gallery while the lightbox is open
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        const lightbox = document.getElementById('lightbox') as HTMLElement;
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'ArrowLeft') lightboxNav(-1);
        if (e.key === 'ArrowRight') lightboxNav(1);
      });

      // Swipe down to close, swipe left/right to navigate the gallery
      const lightboxEl = document.getElementById('lightbox') as HTMLElement;
      let touchStartY = 0;
      let touchStartX = 0;

      lightboxEl?.addEventListener('touchstart', (e: TouchEvent) => {
        touchStartY = e.touches[0].clientY;
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      lightboxEl?.addEventListener('touchend', (e: TouchEvent) => {
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        if (deltaY > 80 && Math.abs(deltaX) < 60) {
          closeLightbox();
        } else if (Math.abs(deltaX) > 60 && Math.abs(deltaY) < 60) {
          lightboxNav(deltaX < 0 ? 1 : -1);
        }
      }, { passive: true });

      (window as any).openLightbox  = openLightbox;
      (window as any).closeLightbox = closeLightbox;
      (window as any).lightboxNav   = lightboxNav;

      // ─── Project card carousels ────────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
        const gallery: string[] = JSON.parse(root.dataset.gallery || '[]');
        const alt = root.dataset.alt || '';
        const track = root.querySelector<HTMLElement>('[data-carousel-track]');
        const prevBtn = root.querySelector<HTMLElement>('[data-carousel-prev]');
        const nextBtn = root.querySelector<HTMLElement>('[data-carousel-next]');
        const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
        const images = Array.from(root.querySelectorAll<HTMLImageElement>('[data-carousel-img]'));
        let index = 0;

        function goTo(i: number) {
          index = (i + gallery.length) % gallery.length;
          if (track) track.style.transform = `translateX(-${index * 100}%)`;
          dots.forEach((dot, di) => {
            dot.classList.toggle('bg-white', di === index);
            dot.classList.toggle('bg-white/50', di !== index);
          });
        }

        prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); goTo(index - 1); });
        nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); goTo(index + 1); });

        images.forEach((img) => {
          img.addEventListener('click', () => openLightboxGallery(gallery, index, alt));
        });

        let cardTouchStartX = 0;
        let cardTouchStartY = 0;
        root.addEventListener('touchstart', (e: TouchEvent) => {
          cardTouchStartX = e.touches[0].clientX;
          cardTouchStartY = e.touches[0].clientY;
        }, { passive: true });
        root.addEventListener('touchend', (e: TouchEvent) => {
          const deltaX = e.changedTouches[0].clientX - cardTouchStartX;
          const deltaY = e.changedTouches[0].clientY - cardTouchStartY;
          if (Math.abs(deltaX) > 40 && Math.abs(deltaY) < 50) {
            goTo(index + (deltaX < 0 ? 1 : -1));
          }
        }, { passive: true });
      });
    </script>

  </body>
</html>
